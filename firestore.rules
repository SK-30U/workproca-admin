rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo estas cuentas de Google pueden leer y escribir. Agrega correos a la lista si quieres dar acceso a alguien más.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['fran.laguna.v@gmail.com'];
    }
  }
}
